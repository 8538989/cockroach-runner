# 管理后台使用用户名和密码登录。请勿把生产密码提交到公开仓库。
COCKROACH_ADMIN_USERNAME=admin
COCKROACH_ADMIN_PASSWORD=replace-with-a-strong-password

# 必须是 Fernet 密钥。生成命令见 README。
COCKROACH_ENCRYPTION_KEY=replace-with-a-fernet-key

# 必填。请向 Evan 获取项目激活码；缺失或错误时服务会拒绝启动。
COCKROACH_ACTIVATION_CODE=replace-with-activation-code

# 宿主机映射端口
COCKROACH_PORT=8790

# 默认仅监听本机，由反向代理提供 HTTPS；确需直接访问时可改为 0.0.0.0
COCKROACH_BIND_IP=127.0.0.1

# 默认使用 Docker 命名卷。迁移已有服务时可填写原数据目录。
# COCKROACH_DATA_DIR=/var/lib/cockroach-runner

# 容器写入数据目录所用 UID/GID；默认镜像内用户为 10001。
# 迁移已有目录时请改为该目录所有者的 UID/GID。
COCKROACH_UID=10001
COCKROACH_GID=10001

# 运行时缓存目录。p115client 等依赖会使用 HOME/XDG 缓存；
# 固定到 /data 可避免使用数字 UID/GID 时写入根目录失败。
HOME=/data
XDG_CACHE_HOME=/data/.cache

# CloudDrive2 的宿主机挂载目录，只读映射到容器 /cd2/miaochuang。
# 每个部署可改成自己的路径；若只使用 CD2 API，该目录不会参与 API 浏览和监听。
COCKROACH_CD2_PATH=/CloudNAS/miaochuang
